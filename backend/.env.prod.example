# Copy this to .env.prod and fill in real values.
# .env.prod is gitignored — never commit it.

# Neon connection string: DIRECT endpoint (Neon → Connect → Connection pooling OFF)
# Two edits to what Neon gives you (see backend/SETUP.md):
#   postgresql://        → postgresql+asyncpg://
#   ?sslmode=require&... → ?ssl=require        (asyncpg rejects sslmode/channel_binding)
DATABASE_URL=postgresql+asyncpg://neondb_owner:your-password@ep-xxxx.c-11.us-east-1.aws.neon.tech/neondb?ssl=require

# JWT — generate with: openssl rand -hex 64
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Update notifications
APP_VERSION=1.0.0
# Must match the NOTIFY_UPDATE_SECRET GitHub Secret exactly
NOTIFY_UPDATE_SECRET=change-me-openssl-rand-hex-32
# Firebase service account JSON (single-line, from Firebase Console → Service Accounts)
FIREBASE_SERVICE_ACCOUNT_JSON={}

# Loki URL for structured log push — must be reachable from the backend container
# Use the Docker Compose internal hostname if Loki runs on the same network (e.g. http://loki:3100)
LOKI_URL=http://loki:3100

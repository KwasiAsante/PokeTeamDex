# Copy to .env (gitignored) next to this file and fill in.

# Neon DIRECT endpoint in Postgres-CLI form: plain postgresql:// and ?sslmode=require.
# (Not the app's asyncpg form: pg_dump/psql reject +asyncpg and ?ssl=require.)
SOURCE_URL=postgresql://neondb_owner:your-password@ep-xxxx.c-11.us-east-1.aws.neon.tech/neondb?sslmode=require

# Password for the local backup Postgres (never exposed outside the Docker network).
# Generate with: openssl rand -hex 24
BACKUP_DB_PASSWORD=change-me

# Daily run time (hour, UTC) and how many dump files to keep.
BACKUP_HOUR_UTC=8
KEEP_DUMPS=14

# Image tag to run (default: latest, built from main). For a branch test build, use the
# branch name with / replaced by -, e.g. feat-neon-local-backup.
BACKUP_IMAGE_TAG=latest

# Optional: push backup log lines to Loki. Leave empty to log to stdout only.
# Only works if this stack can reach Loki; see backend/SETUP.md → "Backups".
LOKI_URL=
